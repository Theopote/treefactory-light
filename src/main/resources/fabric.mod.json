{
	"schemaVersion": 1,
	"id": "treefactory-light",
	"version": "${version}",
	"name": "Treefactory Light",
	"description": "Procedural trees with live previews, presets and undo. Beta for creative builders.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/treefactory-light/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.treefactory.light.TreefactoryLight"
		],
		"client": [
			"com.treefactory.light.client.TreefactoryLightClient"
		]
	},
	"mixins": [
		{"config": "treefactory-light.client.mixins.json", "environment": "client"}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
